# Maintainer: Christian Balcom <robot.inventor@gmail.com>
pkgname=prism-explorer
pkgver=0.1.0
pkgrel=1
pkgdesc="Color-managed file explorer — damascene UI, HDR-aware previews, built for big slow filesystems"
arch=('x86_64')
url="https://github.com/computer-whisperer/prism-explorer"
license=('MIT' 'Apache-2.0')
# Runtime libraries the binary links (verify against `ldd` / `namcap`):
#   libvulkan  -> vulkan-icd-loader (wgpu renderer),
#   libxkbcommon, libwayland-client -> libxkbcommon + wayland (winit + arboard).
# Pure-Rust otherwise: syntect, achromat, jpegxr (vendored C, built static).
depends=('vulkan-icd-loader' 'libxkbcommon' 'wayland')
# A Vulkan ICD (vulkan-radeon / nvidia-utils / vulkan-intel) is required at
# runtime but depends on the GPU, so it is intentionally not pinned here.
# `clang` provides libclang for jpegxr's bindgen step; base-devel supplies cc.
makedepends=('rust' 'cargo' 'git' 'clang')
options=('!lto')

# prism-explorer's only non-crates.io dependency is `achromat` (with its
# vendored `jpegxr`), pinned as a git dependency in the workspace Cargo.toml.
# cargo resolves and fetches that git tree itself from Cargo.lock — both crates
# come from the single achromat git source — so we do NOT lay it out as a
# sibling in $srcdir. prepare() fetches everything (registry + git deps) up
# front, then build() runs --frozen offline.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname"
    # Populate the cargo cache (registry crates + the achromat git dep) while we
    # still have network, so build() can run --frozen with no further fetching.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # Only the GUI binary — the crate also ships a `dump_bundles` lint tool.
    cargo build --release --frozen -p prism-explorer --bin prism-explorer
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm0755 "target/release/prism-explorer" \
        "$pkgdir/usr/bin/prism-explorer"

    # Desktop entry: makes `xdg-open <dir>` and the inode/directory default
    # resolve to prism. Arch's desktop-file-utils / mime hooks refresh the
    # caches on install; the user still picks the default with `xdg-mime`.
    install -Dm0644 "data/prism-explorer.desktop" \
        "$pkgdir/usr/share/applications/prism-explorer.desktop"

    # xdg-desktop-portal FileChooser backend declaration. Only takes effect
    # once preferred in ~/.config/xdg-desktop-portal/portals.conf (per-user).
    install -Dm0644 "data/prism.portal" \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/prism.portal"

    install -Dm0644 "LICENSE-MIT" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm0644 "LICENSE-APACHE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"

    # NOTE: data/org.freedesktop.FileManager1.service is deliberately NOT
    # installed system-wide — that path collides with any other file manager
    # (nautilus, nemo, …) shipping the same activation file, which pacman
    # rejects. Users who want prism to own org.freedesktop.FileManager1 install
    # it per-user to ~/.local/share/dbus-1/services/ (see the README / file
    # header). A running prism still claims the name dynamically regardless.
}
